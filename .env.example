# Career Planning Agent Configuration
PORT=5000

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Preferred Gemini Model (gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash, etc.)
